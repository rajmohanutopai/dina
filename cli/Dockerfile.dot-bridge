# Dot bridge (docs/OPENAI_DOTS_INTEGRATION.md §4): `dina dot-bridge serve`
# behind the shared Caddy TLS front. No owner key, no vault; its only state is
# the links' agent keys and token hashes under /data.
FROM python:3.12-slim

RUN useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin dina \
    && mkdir -p /data && chown dina:dina /data

WORKDIR /src
COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir . && rm -rf /src

USER dina
WORKDIR /data
ENV HOME=/data DINA_DOT_BRIDGE_DIR=/data/bridge PYTHONDONTWRITEBYTECODE=1
EXPOSE 8765
HEALTHCHECK --interval=15s --timeout=5s --retries=3 CMD \
    python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/.well-known/oauth-authorization-server', timeout=4)"
CMD ["dina", "dot-bridge", "serve", "--host", "0.0.0.0", "--port", "8765"]
