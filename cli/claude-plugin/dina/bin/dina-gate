#!/bin/sh
# Dina coding-gate supervisor — Plugin Developer Surface §10 / NEW-27.
#
# Claude Code runs THIS on every tool call (PreToolUse, catch-all). Its only job
# is to run the real gate (`dina gate-hook`) and NORMALIZE EVERY FAILURE TO A
# BLOCK (exit 2). This matters because on a PreToolUse hook, *only* exit 2 blocks
# a tool call — every other outcome (missing binary, crash, signal, a non-2 exit,
# a host timeout) is NON-blocking and would let the tool run. So a stopped or
# broken Dina fails CLOSED here rather than silently opening the gate.
#
# DISCLOSED RESIDUAL (§10, §16): this supervisor can normalize its CHILD's
# failures, but not its OWN. If Claude Code never launches this script (missing/
# unexecutable), this process itself crashes, or the host-side hook timeout fires,
# no exit 2 is emitted and the tool runs. Closing that residual needs an
# independent host-level deny-on-non-returning-hook mechanism; it is stated, not
# hidden. The gate is fail-closed for everything downstream of a launched, living
# supervisor (Core unreachable/slow-within-the-gate-deadline, gate crash,
# malformed reply).

set -u

block() {
  # The reason on stderr becomes the block message Claude Code surfaces.
  printf 'Dina gate: %s — blocked (fail-closed).\n' "$1" >&2
  exit 2
}

SCRIPT_DIR="${0%/*}"
[ "$SCRIPT_DIR" != "$0" ] || SCRIPT_DIR="."
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)}"
CLI="$PLUGIN_ROOT/bin/dina-cli"
BOOTSTRAP_AUTHORIZER="$PLUGIN_ROOT/bin/dina-bootstrap-authorize"

[ -x "$CLI" ] || block "the bundled Dina CLI resolver is missing"
[ -x "$BOOTSTRAP_AUTHORIZER" ] || block "the bootstrap authorizer is missing"

# Preserve the original event while asking the local, non-networked authorizer
# whether this is the bounded setup command. AskUserQuestion is also allowed
# without Core so /dina:setup can collect the identity mode. No other tool gets
# a bootstrap exception.
EVENT="$(cat)"
printf '%s' "$EVENT" | "$BOOTSTRAP_AUTHORIZER"
bootstrap_rc=$?
case "$bootstrap_rc" in
  0)  exit 0 ;;
  10)
    HOME_STATUS="$("$CLI" --json home-node status 2>/dev/null || true)"
    if ! printf '%s' "$HOME_STATUS" |
      "$BOOTSTRAP_AUTHORIZER" --home-node-ready; then
      exit 0
    fi
    ;;
esac

# Outer deadline backstop when a timeout helper exists (macOS ships neither
# `timeout` nor `gtimeout` by default — the gate ALSO self-deadlines ~10s, so
# this is belt-and-suspenders, not the primary guard). exit 124 = it fired.
if command -v timeout >/dev/null 2>&1; then
  printf '%s' "$EVENT" | timeout 15 "$CLI" gate-hook
  rc=$?
elif command -v gtimeout >/dev/null 2>&1; then
  printf '%s' "$EVENT" | gtimeout 15 "$CLI" gate-hook
  rc=$?
else
  printf '%s' "$EVENT" | "$CLI" gate-hook
  rc=$?
fi

case "$rc" in
  0)   exit 0 ;;                                   # allow (or an `ask` the gate printed)
  2)   exit 2 ;;                                   # explicit deny (reason already on stderr)
  124) block "timed out reaching Core" ;;          # timeout(1)/gtimeout killed it
  *)   block "the gate exited abnormally (code $rc)" ;;  # crash / signal / any non-2 exit
esac
