{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DINA_AGENT_HOST=claude-code \"${CLAUDE_PLUGIN_ROOT}/bin/dina-cli\" home-node ensure --if-installed --quiet",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/dina-gate"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "DINA_AGENT_HOST=claude-code \"${CLAUDE_PLUGIN_ROOT}/bin/dina-cli\" session-end-hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
