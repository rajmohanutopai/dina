#!/bin/sh
# Normalize every child-gate failure to exit 2, the blocking PreToolUse result.
# Codex does not support permissionDecision=ask, so moderate-risk calls are sent
# to Dina's durable owner-approval surface and remain blocked until exact retry.

set -u

block() {
  printf "Dina gate: %s - blocked (fail-closed).\n" "$1" >&2
  exit 2
}

command -v dina >/dev/null 2>&1 ||
  block "the 'dina' CLI is not on PATH (pip install dina-agent && dina home-node install)"

if command -v timeout >/dev/null 2>&1; then
  timeout 15 dina gate-hook --host codex
  rc=$?
elif command -v gtimeout >/dev/null 2>&1; then
  gtimeout 15 dina gate-hook --host codex
  rc=$?
else
  dina gate-hook --host codex
  rc=$?
fi

case "$rc" in
  0) exit 0 ;;
  2) exit 2 ;;
  124) block "timed out reaching Core" ;;
  *) block "the gate exited abnormally (code $rc)" ;;
esac
