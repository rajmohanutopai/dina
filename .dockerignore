# Shared by every image built from the repo root. AppView keeps its own,
# narrower list in appview/Dockerfile.dockerignore.
**/node_modules
**/dist
**/.git
**/coverage
**/*.log
**/.DS_Store

# Local state and secrets: never send them to the Docker daemon.
**/.env
**/.env.*
!**/.env.example
secrets/
instances/
dina-nodes/
.claude/
.test-stack.json
.test-stack-keys/
