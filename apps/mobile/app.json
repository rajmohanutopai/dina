{
  "expo": {
    "name": "Dina",
    "slug": "dina-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "dina",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/branding/dina-icon.png",
    "splash": {
      "image": "./assets/branding/dina-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F2EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinakernel.mobile",
      "icon": "./assets/branding/dina-icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/dina-icon.png",
        "backgroundColor": "#E5DDD0"
      },
      "package": "com.dinakernel.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#3b82f6",
          "defaultChannel": "solicited"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "061afa64-783b-4212-acbb-deb8660907f3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/061afa64-783b-4212-acbb-deb8660907f3"
    }
  }
}
