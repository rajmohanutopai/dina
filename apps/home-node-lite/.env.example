# Home Node Lite — environment config.
#
# Copy to `.env` (same directory) before `docker compose up`, or let
# `install-lite.sh` generate one interactively.
#
# See apps/home-node-lite/docker-compose.lite.yml for the matching
# variable names.

# ─── Image tag ─────────────────────────────────────────────────────────
# Pin to a released tag (e.g. `v0.1.0`, `latest`, `sha-abc1234`) or
# keep `dev` to build-from-source locally.
DINA_IMAGE_TAG=dev

# ─── Ports ─────────────────────────────────────────────────────────────
# Host-side ports for the external mapping. Defaults match the Go
# production stack. Set distinct ports when running Lite + production
# side-by-side on one host.
DINA_CORE_PORT_EXTERNAL=8100
DINA_BRAIN_PORT_EXTERNAL=8200

# ─── Hosted Dina endpoints ────────────────────────────────────────────
# release → pds/mailbox/appview.dinakernel.com
# test    → test-pds/test-mailbox/test-appview.dinakernel.com
DINA_ENDPOINT_MODE=release

# ─── PDS integration ───────────────────────────────────────────────────
# Leave blank for dev-mode: Core runs without publishing to PDS.
# For PeerLens participation (M3+), set these to a community
# PDS + your Dina account.
DINA_PDS_URL=https://bsky.social
DINA_PDS_HANDLE=
DINA_PDS_PASSWORD=

# ─── LLM provider ──────────────────────────────────────────────────────
# Brain picks the first non-empty key. At least one must be set for the
# ask/reason endpoints to function (local llama via node-llama-cpp is a
# Phase 5d addition, not in this baseline).
DINA_ANTHROPIC_API_KEY=
DINA_OPENAI_API_KEY=
DINA_GEMINI_API_KEY=

# Default model identifier. Format: `provider:model`. Override to point
# at a larger model for complex reasoning.
DINA_MODEL_DEFAULT=anthropic:claude-haiku-4-5

# ─── Runtime ───────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
DINA_LOG_LEVEL=info

# Core serves the credential-protected owner setup page on localhost.
DINA_CORE_OWNER_CONSOLE=1

# Security mode. Set this BEFORE the first boot and Core stores the master
# seed wrapped under it (no plain keyfile, no recovery-phrase file: Core's
# first-boot log says how to print the phrase once). The powerful owner
# actions — spending, pairing a device, plugin consent, the yes on a money
# card — then need it typed within the last five minutes, on the phone and
# the web alike. Left empty, the node runs in convenience mode: there is no
# passphrase to ask for, so none of those actions is gated, and a script
# running in the owner's browser tab can do all of them. A wrapped node needs
# the passphrase on every boot. Setting it later on a keyfile node changes
# nothing.
DINA_UNLOCK_PASSPHRASE=

# The web app (the mobile app in a browser), served by Core at /app/.
# `install-lite.sh --web-ui` sets both lines. Brain allows exactly the listed
# origins (Core's address, by both loopback names) to read its API; leave
# both empty to serve no web app.
DINA_CORE_WEB_UI=
DINA_BRAIN_WEB_ORIGIN=

# A2A Lane 2: outside A2A agents call this node through the gateway
# (docker compose --profile a2a). Set both or neither. DINA_A2A_PUBLIC_URL is
# the https origin your TLS terminator serves (it fronts 127.0.0.1:8400);
# DINA_A2A_GATEWAY_DID is what `docker compose --profile a2a run --rm
# a2a-gateway keygen` printed. Set DINA_A2A_GATEWAY_TRUST_PROXY=1 when that
# terminator sets X-Forwarded-For, so the gateway limits each client address.
DINA_A2A_PUBLIC_URL=
DINA_A2A_GATEWAY_DID=
DINA_A2A_GATEWAY_TRUST_PROXY=
# Optional: event streams open at once, and per client address (default 500, 20).
DINA_A2A_GATEWAY_MAX_STREAMS=
DINA_A2A_GATEWAY_STREAMS_PER_IP=
