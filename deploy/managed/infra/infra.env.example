# Dina Shared Infrastructure — Deployment Configuration
#
# Copy to infra-prod.env or infra-test.env and fill in before deploying.
# These files are gitignored. Never commit them.
#
# Usage:
#   cp infra.env.example infra-prod.env   # production
#   cp infra.env.example infra-test.env   # test environment
#
#   ./deploy_shared_infra.sh deploy prod
#   ./deploy_shared_infra.sh deploy test

# ── Server ──
REMOTE=dina-infra                    # SSH alias or user@host
REMOTE_DIR=/opt/dina-infra           # Deployment directory on server

# ── Domain ──
DOMAIN=dinakernel.com                # Base domain
PDS_HOST=pds.dinakernel.com          # Community PDS subdomain
MSGBOX_HOST=mailbox.dinakernel.com   # D2D MsgBox subdomain
APPVIEW_HOST=appview.dinakernel.com  # PeerLens subdomain

# ── Optional ──
# COMPOSE_PROJECT=dina-infra-prod    # Docker project name (auto-derived from env)

# ── Secrets (generated on first deploy, stored on server in .env) ──
# These are NOT stored here. They live only on the server at $REMOTE_DIR/deploy/.env
# Generated by: openssl rand -hex 16 (for passwords)
#               openssl rand -base64 32 (for JWT)
#               openssl ecparam -name secp256k1 -genkey -noout (for PDS rotation key)

GRANTS_HOST=
# ── Starter Credits grants service (docs/CREDITS_DESIGN.md) ──
# Crown-jewel secrets — the OpenRouter MANAGEMENT key (not a runtime
# key) and the Apple DeviceCheck .p8 (paste PEM contents, \n-escaped).
OPENROUTER_PROVISIONING_KEY=
APPLE_TEAM_ID=
DEVICECHECK_KEY_ID=
DEVICECHECK_PRIVATE_KEY=
# 'development' for test-grants (dev-signed / TestFlight-internal device tokens).
# PROD MUST set 'production' — App Store device tokens validate only against
# Apple's production endpoint, and `deploy_shared_infra.sh deploy prod` refuses
# to deploy DeviceCheck creds unless DEVICECHECK_ENV=production.
DEVICECHECK_ENV=development
GRANTS_ENABLED_IOS=true
GRANTS_PAUSED=false
GRANTS_GRANT_USD=0.25
GRANTS_MODEL_PIN=deepseek/deepseek-v4-pro
GRANTS_EST_CONVERSATIONS=40
GRANTS_MAX_PER_DAY=500
# Set to 1 to boot without secrets (serves getConfig as paused).
GRANTS_ALLOW_DEGRADED=0
